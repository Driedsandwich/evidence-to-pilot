{
  "name": "evidence-to-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Source-grounded concurrent EINSTEIN collaboration proposals on Mozaik",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data:download": "node scripts/download-data.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "run": "node dist/src/cli.js",
    "demo": "npm run build && node dist/src/demo.js",
    "trace": "node dist/src/trace-report.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.74.0",
    "@google/genai": "2.32.0",
    "@mozaik-ai/core": "4.1.0",
    "dotenv": "16.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
