# CLI defaults to mock even when keys exist. Select --mode live explicitly.
PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Blank MODEL keeps role defaults: Haiku analysts; Sonnet Writer and Critic.
# A nonempty MODEL overrides all role defaults.
MODEL=

# Optional per-role overrides, all under PROVIDER.
# Precedence: nonempty role override > nonempty MODEL > provider/role default.
# Anthropic defaults: claude-haiku-4-5 for COMPANY/RESEARCH,
# claude-sonnet-5-5 for WRITER/CRITIC.
COMPANY_MODEL=
RESEARCH_MODEL=
WRITER_MODEL=
CRITIC_MODEL=

# Alternative: PROVIDER=gemini; blank MODEL/role overrides use gemini-3.5-flash.
GEMINI_API_KEY=

MAX_CONCURRENT=2
REQUESTS_PER_MINUTE=30
# Three challenges: 12 normal tasks; up to 51 with repairs and claim recovery.
# At one HTTP retry each, the 96-attempt ceiling can stop the 102-attempt worst case.
MAX_PROVIDER_CALLS=96
MAX_RETRIES=1
# Aggregate backoff wait across the whole run (not per agent).
MAX_RETRY_WAIT_MS=120000
RETRY_BASE_MS=1000
RETRY_MAX_MS=30000
REQUEST_TIMEOUT_MS=90000
MAX_OUTPUT_TOKENS=4096
BUDGET_USD=2

# Planning assumptions, NOT verified current provider prices. Set these to
# conservative rates for your account/model before live inference.
INPUT_USD_PER_MILLION=3
OUTPUT_USD_PER_MILLION=15

# Mozaik Cloud export is deliberately disabled by the application, including
# discovery of local cached cloud credentials. Do not add cloud credentials.
