# CLI defaults to mock even when keys exist. Select --mode live explicitly.
PROVIDER=gemini
MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Optional per-role overrides, all under PROVIDER; blank means use MODEL.
COMPANY_MODEL=
RESEARCH_MODEL=
WRITER_MODEL=
CRITIC_MODEL=

# Alternative: PROVIDER=anthropic and MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

MAX_CONCURRENT=2
REQUESTS_PER_MINUTE=30
# Three challenges: 12 normal calls, 24 with two writer/critic revisions each;
# up to 48 tasks with validation repairs, 96 attempts with one HTTP retry each.
MAX_PROVIDER_CALLS=96
MAX_RETRIES=1
# Aggregate backoff wait across the whole run (not per agent).
MAX_RETRY_WAIT_MS=120000
RETRY_BASE_MS=1000
RETRY_MAX_MS=30000
REQUEST_TIMEOUT_MS=90000
MAX_OUTPUT_TOKENS=4096
BUDGET_USD=2

# Planning assumptions, NOT verified current provider prices. Set these to
# conservative rates for your account/model before live inference.
INPUT_USD_PER_MILLION=1
OUTPUT_USD_PER_MILLION=5

# Mozaik Cloud export is deliberately disabled by the application, including
# discovery of local cached cloud credentials. Do not add cloud credentials.
